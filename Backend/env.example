# Configuration de base
NODE_ENV=development
PORT=3001

# Base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/occazcar

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here

# Stripe Configuration (pour les paiements)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Configuration Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@occazcar.fr
SMTP_PASS=your-email-password

# Configuration OccazCar
OCCAZCAR_COMMISSION_RATE=2.5
OCCAZCAR_MIN_COMMISSION=50
OCCAZCAR_MAX_COMMISSION=500

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
